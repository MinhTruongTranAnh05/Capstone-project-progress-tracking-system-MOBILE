# Environment variables for Capstone Mobile
# Copy this file to .env and update values

# API Base URL
# Must target the v2.9 backend branch feat/team-formation-v2.8 (not old BE main).
# Android Emulator: http://10.0.2.2:8081/api/v1
# iOS Simulator: http://localhost:8081/api/v1
# Physical device: http://YOUR_IP:8081/api/v1
# Deployed backend: https://your-backend.up.railway.app/api/v1
# Replacement BE supplied 2026-11-03; OpenAPI and public Google config verified HTTP 200.
EXPO_PUBLIC_API_URL=https://cortex-bristle-ferry.ngrok-free.dev/api/v1

# Optional override; otherwise GET /auth/google/config supplies the Web OAuth client ID.
# Must be a WEB client ID allowed by the backend GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=767326459136-ue5gjkbhqajuavnill5ctk0a9hm97qo9.apps.googleusercontent.com
# Required for iOS builds (iOS OAuth client for com.fpt.capstone.mobile).
# Changing this value requires rebuilding the native app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=767326459136-2v2jrft09t0kukvdc855rgq7arn91fee.apps.googleusercontent.com
# Public OAuth identifiers supplied by the owner. Never add a client secret here.
# BE must allow the Web ID above in GOOGLE_CLIENT_IDS before real login can work.
