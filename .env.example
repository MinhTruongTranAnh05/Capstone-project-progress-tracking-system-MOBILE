# Environment variables for Capstone Mobile
# Copy this file to .env and update values

# API Base URL
# Must target the v2.9 backend branch feat/team-formation-v2.8 (not old BE main).
# Android Emulator: http://10.0.2.2:8081/api/v1
# iOS Simulator: http://localhost:8081/api/v1
# Physical device: http://YOUR_IP:8081/api/v1
# Deployed backend: https://your-backend.up.railway.app/api/v1
# Replacement BE supplied 2026-11-03; OpenAPI and public Google config verified HTTP 200.
EXPO_PUBLIC_API_URL=https://cortex-bristle-ferry.ngrok-free.dev/api/v1

# BE-supplied Web OAuth client for the browser. Public config is a fallback on web only.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=336326792584-via4aii2ugfnqg7qgee3st7amav9jg56.apps.googleusercontent.com
# BE-supplied Web OAuth client named "mobile", used as the native SDK's server audience.
# The matching Android OAuth client must be registered in this client's Google Cloud project.
EXPO_PUBLIC_GOOGLE_MOBILE_WEB_CLIENT_ID=191002082253-suft0ihkl6o9vt2620g27sqg7atgu6qq.apps.googleusercontent.com
# Awaiting a BE-supplied iOS OAuth client for com.fpt.capstone.mobile.
# Both supplied IDs above are WEB clients and cannot replace an iOS OAuth client.
# Setting an iOS ID/callback scheme requires rebuilding the native iOS app.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Client IDs are public. Never add a client secret here.
# The running BE must accept each platform's server audience in GOOGLE_CLIENT_IDS.
