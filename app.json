{
  "expo": {
    "name": "Lich Do An",
    "slug": "capstone-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "capstone-mobile",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fpt.capstone.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF9F5"
      },
      "package": "com.fpt.capstone.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
