{
  "expo": {
    "name": "MatchPoint FPT",
    "slug": "capstone-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "capstone-mobile",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fpt.capstone.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF9F5"
      },
      "package": "com.fpt.capstone.mobil"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF9F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "0f5d9332-5ac4-4fe8-8a78-42c5c6f6faa8"
      }
    },
    "owner": "minhtruongtrananh05"
  }
}
