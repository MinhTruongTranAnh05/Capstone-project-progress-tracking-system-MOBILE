  "scripts": {
    "test": "node --test scripts/auth.test.cjs scripts/formation.test.cjs scripts/contract.test.cjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test:auth": "node --test scripts/auth.test.cjs",
